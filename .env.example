# Copy to .env.local and fill in. NEVER commit .env.local or any real secret.

# Admin username for the demo dashboard
ADMIN_USERNAME=admin

# scrypt hash of the admin password. Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Random string, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional: SQLite file path (default: ./data/demo-kyc.db)
# DATABASE_PATH=./data/demo-kyc.db
