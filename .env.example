# Copy to .env.local for local development. NEVER commit .env.local or any real secret.
# On Vercel, set these in Project Settings > Environment Variables (see README).
# Everything here is a placeholder.

# --- Database (PostgreSQL) ---------------------------------------------------
# Runtime connection. On serverless/Vercel use your provider's POOLED connection string.
# Write sslmode=verify-full for any remote host (see docs/DEPLOYMENT.md, "TLS note").
# For local Postgres on localhost you can drop the sslmode part.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full"

# Migrations connection. Use the DIRECT (non-pooled) string; poolers can break migrations.
# If unset, DATABASE_URL is used.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full"

# Optional: max connections per server instance (default 5). Keep low on serverless.
# DATABASE_POOL_MAX=5

# --- Admin login -------------------------------------------------------------
ADMIN_USERNAME=admin

# scrypt hash of the admin password. Generate with: npm run hash-password  (hidden prompt;
# the password is never accepted on the command line so it cannot end up in shell history)
# In .env.local ONLY, write every $ as \$  (Next.js would otherwise expand it and truncate the hash):
#   ADMIN_PASSWORD_HASH=scrypt\$<salt>\$<hash>
# In Vercel, paste the hash as-is (see docs/DEPLOYMENT.md).
ADMIN_PASSWORD_HASH=

# Random string, at least 32 characters. Generate with: openssl rand -base64 48
# Changing it signs every admin out.
SESSION_SECRET=

# --- Migrations during Vercel builds (opt-in, see README) --------------------
# Set to 1 ONLY on the Vercel Preview environment, together with a Preview-only DIRECT_URL.
# RUN_DB_MIGRATIONS=1
# Never set this unless you intend a production build to migrate production:
# ALLOW_PRODUCTION_MIGRATIONS=1

# --- Tests only (never set these in Vercel) ----------------------------------
# A throwaway Postgres database (tests create and drop their own schemas in it).
# NEVER point this at preview or production data.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dfk_test"
# Make a missing/unreachable test database a hard failure instead of a skip (CI sets this):
# REQUIRE_DB_TESTS=1
